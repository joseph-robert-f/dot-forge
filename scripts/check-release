#!/usr/bin/env python3
"""Source checks; opt-in PRINTKIT_INTEGRATION, PRINTKIT_FREECAD_INTEGRATION and
PRINTKIT_DOT_INTEGRATION run actual native and bundle-regeneration fixtures."""
from pathlib import Path
import os
import subprocess
import sys
root=Path(__file__).resolve().parents[1]
env=dict(os.environ, PYTHONPATH=str(root/'src'))
result=subprocess.run([sys.executable,'-m','unittest','discover','-s','tests','-v'],cwd=root,env=env)
raise SystemExit(result.returncode)
