{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joseph-robert-f/dot-forge/schemas/intent.v1.json",
  "title": "Dot Forge intent spec v1",
  "description": "The user's ask as measurable checks. Positions are mm from the minimum corner of the part's bounding box. src/printkit/intent.py is authoritative and also checks values against the envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ask",
    "units",
    "envelope",
    "solid_count",
    "features",
    "unknowns",
    "confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": "intent.v1"
    },
    "ask": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "The user's words. Data only."
    },
    "units": {
      "const": "mm"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_mm",
        "tolerance_mm"
      ],
      "properties": {
        "size_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 500
          }
        },
        "tolerance_mm": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5
        }
      }
    },
    "solid_count": {
      "const": 1
    },
    "volume_mm3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 125000000
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 125000000
        }
      }
    },
    "features": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "axis",
              "diameter_mm",
              "position_mm",
              "depth",
              "tolerance_mm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "kind": {
                "const": "hole"
              },
              "axis": {
                "enum": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 500
              },
              "position_mm": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "description": "Axis z: [x, y]. Axis y: [x, z]. Axis x: [y, z]."
              },
              "depth": {
                "oneOf": [
                  {
                    "const": "through"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "depth_mm",
                      "open_end"
                    ],
                    "properties": {
                      "depth_mm": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 500
                      },
                      "open_end": {
                        "enum": [
                          "min",
                          "max"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ends"
                    ],
                    "description": "What each end opens into. outside: clear to the outside of the part. floor: a filled end. void: empty space inside the part, such as a bore or cavity. shoulder: a filled step around a narrower coaxial hole. One end must be outside.",
                    "properties": {
                      "ends": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "min",
                          "max"
                        ],
                        "properties": {
                          "min": {
                            "enum": [
                              "outside",
                              "floor",
                              "void",
                              "shoulder"
                            ]
                          },
                          "max": {
                            "enum": [
                              "outside",
                              "floor",
                              "void",
                              "shoulder"
                            ]
                          }
                        }
                      },
                      "depth_mm": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 500
                      }
                    },
                    "anyOf": [
                      {
                        "properties": {
                          "ends": {
                            "properties": {
                              "min": {
                                "const": "outside"
                              }
                            }
                          }
                        }
                      },
                      {
                        "properties": {
                          "ends": {
                            "properties": {
                              "max": {
                                "const": "outside"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "tolerance_mm": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 5
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "normal",
              "offset",
              "min_area_mm2",
              "tolerance_mm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "kind": {
                "const": "planar_face"
              },
              "normal": {
                "enum": [
                  "+x",
                  "-x",
                  "+y",
                  "-y",
                  "+z",
                  "-z"
                ]
              },
              "offset": {
                "oneOf": [
                  {
                    "enum": [
                      "min",
                      "max"
                    ]
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              },
              "min_area_mm2": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 250000
              },
              "max_area_mm2": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 250000,
                "description": "Optional upper bound on the summed area. It must not be less than min_area_mm2."
              },
              "tolerance_mm": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 5
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "kind": {
                "const": "note"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "confirmed"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "required": [
          "by"
        ],
        "properties": {
          "by": {
            "const": "user"
          }
        }
      }
    }
  }
}
