{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joseph-robert-f/dot-forge/schemas/model-request.v1.json",
  "title": "Dot Forge model request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_id",
    "generator_version",
    "backend",
    "units",
    "parameters",
    "dimensions_mm",
    "tolerance_mm",
    "allowed_components",
    "part_count",
    "export_formats",
    "render_profile",
    "validation_profile",
    "printer_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "generator_id": {
      "enum": [
        "calibration-block",
        "geometric-mascot",
        "lane-a-character"
      ]
    },
    "generator_version": {
      "const": "1"
    },
    "backend": {
      "const": "blender"
    },
    "units": {
      "const": "mm"
    },
    "parameters": {
      "type": "object"
    },
    "dimensions_mm": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 1,
        "maximum": 200
      }
    },
    "tolerance_mm": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 1
    },
    "allowed_components": {
      "const": 1
    },
    "part_count": {
      "const": 1
    },
    "export_formats": {
      "const": [
        "stl",
        "blend"
      ]
    },
    "render_profile": {
      "const": "five-view"
    },
    "validation_profile": {
      "const": "solid-single-part"
    },
    "printer_profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "print-profile.v1.json"
        }
      ]
    }
  },
  "description": "CLI applies additional strict generator parameter and printer-profile validation.",
  "allOf": [
    {
      "if": {
        "properties": {
          "generator_id": {
            "const": "calibration-block"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width_mm",
              "depth_mm",
              "height_mm"
            ],
            "properties": {
              "width_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              },
              "depth_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              },
              "height_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generator_id": {
            "const": "geometric-mascot"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width_mm",
              "depth_mm",
              "height_mm"
            ],
            "properties": {
              "width_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              },
              "depth_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              },
              "height_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generator_id": {
            "const": "lane-a-character"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
