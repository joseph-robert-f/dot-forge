{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "print-profile v1",
  "type": "object",
  "required": [
    "process",
    "build_envelope_mm",
    "minimum_wall_mm",
    "minimum_clearance_mm"
  ],
  "properties": {
    "process": {
      "const": "fdm"
    },
    "build_envelope_mm": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 1,
        "maximum": 2000
      }
    },
    "minimum_wall_mm": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 20
    },
    "minimum_clearance_mm": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 20
    }
  },
  "additionalProperties": false
}
